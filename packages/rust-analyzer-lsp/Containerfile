ARG RUST_IMAGE=rust:1.96.0-slim-bookworm@sha256:4732ca96fd086cb9be682050c3f0176288eebaac2b80aa2bcefccfaf198e1950
ARG DEBIAN_IMAGE=debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818
ARG RUST_TOOLCHAIN=1.96.0
FROM ${RUST_IMAGE} AS toolchain

ARG RUST_TOOLCHAIN=1.96.0
RUN rustup component add --toolchain "${RUST_TOOLCHAIN}" rust-analyzer rust-src

FROM ${DEBIAN_IMAGE}

ARG RUST_TOOLCHAIN=1.96.0
ARG PB_LSP_MANIFEST
ARG PB_CONFIG_SCHEMA

RUN test -n "${PB_LSP_MANIFEST}" \
    && test -n "${PB_CONFIG_SCHEMA}" \
    && groupadd --gid 65532 pb \
    && useradd --uid 65532 --gid 65532 --home-dir /tmp/pb-home --no-create-home pb

COPY --from=toolchain /usr/local/rustup /usr/local/rustup
COPY --from=toolchain /usr/local/cargo /usr/local/cargo

ENV PATH=/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin \
    RUSTUP_HOME=/usr/local/rustup \
    RUSTUP_TOOLCHAIN=${RUST_TOOLCHAIN} \
    CARGO_HOME=/tmp/cargo \
    CARGO_NET_OFFLINE=true \
    HOME=/tmp/pb-home

LABEL org.opencontainers.image.title="pb rust-analyzer LSP" \
      org.opencontainers.image.description="Offline, read-only rust-analyzer sidecar for pb" \
      org.opencontainers.image.source="https://github.com/crunchy-pb/rust-analyzer-lsp" \
      org.opencontainers.image.licenses="MIT" \
      uk.unrtd.pb.integration.config-schema="${PB_CONFIG_SCHEMA}" \
      uk.unrtd.pb.integration.lsp-manifest="${PB_LSP_MANIFEST}"

USER 65532:65532
ENTRYPOINT ["rust-analyzer"]
