{
  "version": 1,
  "mutation": "required",
  "allowed_paths": [
    "index.html",
    "game.js",
    "game.test.js",
    "styles.css"
  ],
  "checks": [
    {
      "id": "offline_dependencies",
      "command": "sh check-offline-web.sh",
      "cwd": ".",
      "required": true,
      "timeout_seconds": 30
    }
  ],
  "commit": {
    "required": true,
    "semantic": true
  },
  "workspace_clean": true
}
