{
  "version": 1,
  "cases": [
    {
      "id": "valid_single_build",
      "hypothesis": "One bounded Build Task dispatches directly without a multi-Task run.",
      "category": "deterministic",
      "context": {
        "intent": "build",
        "goal_selection_qualified": false,
        "max_tasks": 6
      },
      "attempts": [{
        "objective": "Fix the average divisor and add a regression test.",
        "requirements": [
          {
            "id": "r1",
            "description": "Correct the divisor and cover the defect."
          }
        ],
        "tasks": [
          {
            "id": "t1",
            "title": "Correct average calculation",
            "description": "Fix the bounded calculation defect and add its regression test.",
            "requirement_ids": ["r1"],
            "depends_on": [],
            "acceptance_ids": ["a1"],
            "scope_hints": ["calculation implementation and tests"],
            "effort": "small",
            "kind": "build"
          }
        ],
        "acceptance": [
          {
            "id": "a1",
            "description": "The regression test fails before the fix and passes after it."
          }
        ],
        "risks": []
      }],
      "expected": {
        "outcome": "accepted",
        "reason": "valid_single_build",
        "dispatch": "build"
      }
    },
    {
      "id": "valid_single_goal_explicit",
      "hypothesis": "Explicit Goal intent may dispatch one Goal Task through the existing Goal flow even when automatic Goal selection is not qualified.",
      "category": "deterministic",
      "context": {
        "intent": "goal",
        "goal_selection_qualified": false,
        "max_tasks": 6
      },
      "attempts": [{
        "objective": "Make import recovery demonstrably restart-safe.",
        "requirements": [
          {
            "id": "r1",
            "description": "Prove restart-safe, idempotent recovery."
          }
        ],
        "tasks": [
          {
            "id": "t1",
            "title": "Prove restart-safe recovery",
            "description": "Use bounded Goal execution to satisfy and verify the recovery criteria.",
            "requirement_ids": ["r1"],
            "depends_on": [],
            "acceptance_ids": ["a1"],
            "scope_hints": ["import recovery"],
            "effort": "large",
            "kind": "goal",
            "goal_contract": {
              "objective": "Make import recovery restart-safe.",
              "criteria": [
                {
                  "text": "Interrupted imports resume without duplicate rows.",
                  "verifier": "workflow_ready"
                }
              ],
              "continuation": "review_plan_then_automatic"
            }
          }
        ],
        "acceptance": [
          {
            "id": "a1",
            "description": "The existing Goal verifier accepts current restart and idempotency evidence."
          }
        ],
        "risks": [
          {
            "description": "Crash timing may expose more than one required child Build."
          }
        ]
      }],
      "expected": {
        "outcome": "accepted",
        "reason": "explicit_goal_intent",
        "dispatch": "goal"
      }
    },
    {
      "id": "valid_multi_task",
      "hypothesis": "A qualified acyclic Build/Goal plan with full coverage creates a multi-Task run.",
      "category": "deterministic",
      "context": {
        "intent": "build",
        "goal_selection_qualified": true,
        "max_tasks": 6
      },
      "attempts": [{
        "objective": "Add durable restart-safe CSV imports and user-visible progress.",
        "requirements": [
          { "id": "r1", "description": "Persist import lifecycle state." },
          {
            "id": "r2",
            "description": "Prove restart-safe idempotent execution."
          },
          {
            "id": "r3",
            "description": "Expose compatible APIs and UI progress."
          }
        ],
        "tasks": [
          {
            "id": "t1",
            "title": "Persist import lifecycle",
            "description": "Add the durable schema and lifecycle transitions with colocated tests.",
            "requirement_ids": ["r1"],
            "depends_on": [],
            "acceptance_ids": ["a1"],
            "scope_hints": ["storage and migration"],
            "effort": "medium",
            "kind": "build"
          },
          {
            "id": "t2",
            "title": "Prove restart-safe execution",
            "description": "Use the existing Goal engine to establish recovery and idempotency guarantees.",
            "requirement_ids": ["r2"],
            "depends_on": ["t1"],
            "acceptance_ids": ["a2"],
            "scope_hints": ["import worker and recovery tests"],
            "effort": "large",
            "kind": "goal",
            "goal_contract": {
              "objective": "Make import execution restart-safe and idempotent.",
              "criteria": [
                {
                  "text": "Interrupted imports resume without duplicate rows.",
                  "verifier": "workflow_ready"
                }
              ],
              "continuation": "review_plan_then_automatic"
            }
          },
          {
            "id": "t3",
            "title": "Expose APIs and progress UI",
            "description": "Add compatible status/cancel APIs and tested progress UI.",
            "requirement_ids": ["r3"],
            "depends_on": ["t2"],
            "acceptance_ids": ["a3"],
            "scope_hints": ["API and web UI"],
            "effort": "medium",
            "kind": "build"
          }
        ],
        "acceptance": [
          { "id": "a1", "description": "Lifecycle state survives restart." },
          {
            "id": "a2",
            "description": "Recovery evidence satisfies the Goal criteria."
          },
          {
            "id": "a3",
            "description": "API and web tests cover progress, cancel, error, and retry."
          }
        ],
        "risks": [
          { "description": "Migration ordering must precede worker changes." }
        ]
      }],
      "expected": {
        "outcome": "accepted",
        "reason": "valid_multi_task",
        "dispatch": "multi_task"
      }
    },
