{
  "nodeModulesDir": "auto",
  "tasks": {
    "build:web": "deno run --allow-all npm:@rsbuild/core/rsbuild build",
    "test:web": "deno test --allow-read --unstable-sloppy-imports webui/src"
  },
  "imports": {
    "@rsbuild/core": "npm:@rsbuild/core@^2.0.11",
    "@rsbuild/plugin-react": "npm:@rsbuild/plugin-react@^2.0.1",
    "bootstrap": "npm:bootstrap@^5.3.8",
    "react": "npm:react@^19.2.7",
    "react-dom": "npm:react-dom@^19.2.7",
    "bootstrap-icons": "npm:bootstrap-icons@^1.11.3",
    "react-router-dom": "npm:react-router-dom@^7.18.0"
  }
}
