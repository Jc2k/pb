{
  "version": 1,
  "mutation": "required",
  "allowed_paths": ["game.js", "game-logic.test.mjs"],
  "work_unit_guidance": {
    "game-logic.test.mjs": "Keep the test file compact and dependency-free; use only local imports and local assertion helpers."
  },
  "checks": [
    {
      "id": "logic",
      "command": "deno test game-logic.test.mjs",
      "cwd": ".",
      "required": true,
      "diagnostic_eligible": true,
      "timeout_seconds": 60
    }
  ],
  "commit": { "required": true, "semantic": true },
  "review": {
    "required": true,
    "read_paths": ["game.js"],
    "check_ids": ["logic"]
  },
  "workspace_clean": true
}
